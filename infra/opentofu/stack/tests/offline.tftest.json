  "run": {
    "topology": {
      "command": "plan",
      "plan_options": {
        "refresh": false
      },
      "assert": [
        {
          "condition": "${output.invariants.network.az_count == 2 && output.invariants.network.nat_per_az == 2 && output.invariants.network.isolated_database}",
          "error_message": "Per-AZ private topology required."
        },
        {
          "condition": "${output.invariants.data.multi_az && !output.invariants.data.public && output.invariants.data.encrypted && output.invariants.data.managed_password}",
          "error_message": "Private Multi-AZ encrypted RDS with managed credentials required."
        },
        {
          "condition": "${output.invariants.data.pitr_days == 35 && output.invariants.data.backup_days == 35 && output.invariants.data.final_snapshot}",
          "error_message": "35-day local and cross-region recovery and final snapshots required."
        },
        {
          "condition": "${output.invariants.media.private_buckets == 2 && output.invariants.media.versioned_buckets == 2 && output.invariants.media.encrypted_buckets == 2 && !output.invariants.media.source_cdn_access}",
          "error_message": "Original and derivative media must be separately private/versioned/encrypted."
        },
        {
          "condition": "${length(output.invariants.compute.services) == 4 && alltrue([for s in output.invariants.compute.services : s.desired_count == 2 && !s.public_ip]) && !output.invariants.compute.services.worker.ingress}",
          "error_message": "Four private digest services each keep two tasks; Worker has no load balancer."
        },
        {
          "condition": "${output.invariants.compute.internal_alb && output.invariants.compute.separate_roles == 4}",
          "error_message": "Internal ALB and app IAM isolation required."
        },
        {
          "condition": "${output.invariants.edge.dynamic_cache_ttl == 0 && output.invariants.edge.origin_protocol == \"https-only\" && output.invariants.edge.oac_signing == \"always\" && !output.invariants.edge.sampled_requests && output.invariants.edge.error_cache_ttl == 0}",
          "error_message": "Private dynamic paths and error responses must not cache or log credentials; origin/OAC must use TLS."
        },
        {
          "condition": "${output.invariants.operations.monthly_budget > 0 && output.invariants.operations.alarm_count == 14 && output.invariants.operations.deployment_uses_oidc}",
          "error_message": "Budget, capacity alarms and scoped OIDC deployment role required."
        },
        {
          "condition": "${output.deployment_manifest.schemaVersion == 1 && !output.deployment_manifest.cloudEvidence && output.deployment_manifest.images == tomap(var.images)}",
          "error_message": "Manifest must preserve release identity without claiming cloud acceptance."
        },
        {
          "condition": "${output.invariants.edge.managed_count && output.invariants.edge.rate_count}",
          "error_message": "Unreviewed WAF rollout must remain observable count-before-block."
        },
        {
          "condition": "${length(output.invariants.compute.backend_paths) == 1 && contains(output.invariants.compute.backend_paths, \"/api/v1/*\")}",
          "error_message": "Nest ALB routing must preserve Next /api/admin/session and /api/cart BFFs."
        },
        {
          "condition": "${contains(output.invariants.media.source_upload_headers, \"if-none-match\") && contains(output.invariants.media.source_upload_headers, \"x-amz-checksum-sha256\")}",
          "error_message": "Source upload CORS must permit the immutable grant and checksum headers."
        },
        {
          "condition": "${alltrue([for actions in output.invariants.compute.application_envelope_actions : contains(actions, \"kms:GenerateDataKeyWithoutPlaintext\") && contains(actions, \"kms:Decrypt\")])}",
          "error_message": "Envelope IAM must support the actual support-intent KMS adapter."
        },
        {
          "condition": "${length(output.invariants.compute.application_mac_actions) == 2 && alltrue([for actions in output.invariants.compute.application_mac_actions : length(actions) == 1 && contains(actions, \"kms:GenerateMac\")])}",
          "error_message": "Blind-index HMAC permissions must use separate key references and only the actual GenerateMac operation."
        },
        {
          "condition": "${length(try(output.invariants.edge.operation_rates, {})) == 6}",
          "error_message": "Six operation-specific rate rules must protect sensitive public requests."
        },
        {
          "condition": "${length(output.invariants.edge.operation_rates) == 6 && alltrue([for key, policy in output.invariants.edge.operation_rates : policy.limit == var.operation_rate_limits[key].limit && policy.window_seconds == var.operation_rate_limits[key].window_seconds && policy.aggregate_key_type == \"IP\" && !policy.sampled_requests && length(policy.scope) == 1 && policy.count && !policy.block])}",
          "error_message": "All sensitive operation scopes must enforce explicit IP policies with the reviewed rollout mode and no raw samples."
        },
        {
          "condition": "${output.invariants.edge.global_rate_limit.limit == var.rate_limit && output.invariants.edge.global_rate_limit.window_seconds == var.rate_limit_window_seconds && output.invariants.edge.global_rate_limit.aggregate_key_type == \"IP\"}",
          "error_message": "Keep global viewer-IP rate protection alongside operation-specific rules."
        },
        {
          "condition": "${alltrue([for key, routes in output.invariants.edge.operation_routes : alltrue([for route in routes : strcontains(jsonencode(output.invariants.edge.operation_rates[key].scope), jsonencode(route.path)) && strcontains(jsonencode(output.invariants.edge.operation_rates[key].scope), jsonencode(route.method))]) && strcontains(jsonencode(output.invariants.edge.operation_rates[key].scope), \"URL_DECODE\") && strcontains(jsonencode(output.invariants.edge.operation_rates[key].scope), \"NORMALIZE_PATH\")])}",
          "error_message": "Planned WAF scopes must contain the reviewed method/path pairs and canonicalization transforms."
        }
      ]
    },
