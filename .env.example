# Runtime tier. Keep these aligned: development/development, test/test,
# and production for preview, staging, or production deployments.
NODE_ENV=development
FAN_SUPPORT_DEPLOYMENT_ENV=development

# Public browser origin. HTTP is accepted only for loopback development/test;
# preview accepts only https://localhost:3443 or https://localhost:3444.
FAN_SUPPORT_SITE_ORIGIN=http://localhost:3000

# Server-only upstream for trusted Storefront-to-API calls. HTTP is accepted
# in development/test. Preview requires exactly http://api:3002, while
# staging/production require HTTPS.
FAN_SUPPORT_INTERNAL_API_ORIGIN=http://localhost:3002

# Optional anonymous performance metrics. Disabled unless explicitly enabled.
# local is only for development/test/preview/staging; field requires production.
# Sampling is per document in permille (0 disables, 1000 samples every document).
# See docs/operations/rum.md before enabling or interpreting field data.
FAN_SUPPORT_RUM_MODE=disabled
FAN_SUPPORT_RUM_SAMPLE_PERMILLE=1000

# Required only by processes that connect to PostgreSQL. Supply locally or via
# the deployment secret manager; never commit a credential-bearing value.
FAN_SUPPORT_DATABASE_URL=

# Anonymous cart KMS configuration. All five references are required together.
# Map version labels to immutable KMS key ARNs in the specified region; the
# active label must be present. Keep at most four MAC versions during rotation.
# AWS credentials come from the server SDK credential chain, never browser input.
# Empty configuration keeps the cart unavailable; local integration uses an
# explicit TEST adapter. New cart lifetime is currently 24 hours.
# FAN_SUPPORT_CART_KMS_REGION=
# FAN_SUPPORT_CART_ENCRYPTION_KEY_VERSION=
# FAN_SUPPORT_CART_ENCRYPTION_KEY_IDS_JSON=
# FAN_SUPPORT_CART_BLIND_INDEX_KEY_VERSION=
# FAN_SUPPORT_CART_BLIND_INDEX_KEY_IDS_JSON=

# Payment adapter code ships with the release; deployed accounts activate only
# through the management center's published payment settings. Runtime JSON
# follows PaymentRuntimeConfiguration and enables the checkout payment routes.
# Account connections are an array of PaymentAccountConnection (immutable
# merchant, protocol, origins and a secret-ref credential reference) with
# exactly one PaymentHealthPolicy each. An account without deployed adapter code
# stops startup. TEST provider injection is separate from production composition.
# The storefront allowlist contains only exact HTTPS origins from the bindings.
# No provider credentials or hosted action tokens belong in these JSON values.
# See docs/runbooks/production-configuration.md.
# Webhook endpoints are an array of PaymentGatewayWebhookConfig; each one belongs to
# a deployed account and needs that adapter's verification code. Provider secrets
# are injected by the secret manager as PAYMENT_SECRET_* variables and referenced
# as secret-ref:v1:env:<NAME>; no other variable is readable through a reference.
# FAN_SUPPORT_PAYMENT_RUNTIME_CONFIG_JSON=
# FAN_SUPPORT_PAYMENT_ACCOUNT_CONNECTIONS_JSON=
# FAN_SUPPORT_PAYMENT_HEALTH_POLICIES_JSON=
# FAN_SUPPORT_PAYMENT_WEBHOOK_ENDPOINTS_JSON=
# FAN_SUPPORT_PAYMENT_ACTION_ORIGINS_JSON=

# The publication purge worker requires CloudFront configuration in staging and
# production, using the AWS ambient credential chain. Local/test/preview may
# leave these unset: jobs then report CONFIGURATION_ERROR, never false success.
# FAN_SUPPORT_CACHE_PURGE_PROVIDER=cloudfront
# FAN_SUPPORT_CACHE_PURGE_REGION=
# FAN_SUPPORT_CACHE_PURGE_DISTRIBUTION_ID=

# Use static auth with HTTPS-only S3-compatible endpoints in development/test.
# Preview is intentionally restricted to the exact local compose topology in
# infra/compose.preview.yml. The service endpoint is used by the server-side S3
# client; the presign endpoint must be reachable by the browser receiving a
# signed grant. They may be identical in local development and test.
# Staging/production must use ambient auth (the AWS default credential chain),
# leave both endpoint/credential values unset, and keep path-style addressing
# false.
# Source and derivative buckets must be different. The public media origin must
# be a credential-free HTTPS origin without path, query, or fragment values.
# The upload byte limit is deployment-owned; 10 MiB is the preview/default
# baseline and can be lowered or raised without changing adapter code.
FAN_SUPPORT_OBJECT_STORAGE_AUTH_MODE=static
FAN_SUPPORT_OBJECT_STORAGE_ENDPOINT=
FAN_SUPPORT_OBJECT_STORAGE_PRESIGN_ENDPOINT=
FAN_SUPPORT_OBJECT_STORAGE_SOURCE_BUCKET=
FAN_SUPPORT_OBJECT_STORAGE_DERIVATIVE_BUCKET=
FAN_SUPPORT_OBJECT_STORAGE_PUBLIC_MEDIA_ORIGIN=
FAN_SUPPORT_OBJECT_STORAGE_MAX_UPLOAD_BYTES=10485760
FAN_SUPPORT_OBJECT_STORAGE_REGION=
FAN_SUPPORT_OBJECT_STORAGE_ACCESS_KEY_ID=
FAN_SUPPORT_OBJECT_STORAGE_SECRET_ACCESS_KEY=
FAN_SUPPORT_OBJECT_STORAGE_FORCE_PATH_STYLE=

# Local administrative TEST workspace is opt-in.
FAN_SUPPORT_ADMIN_MODE=DISABLED
# LOCAL_OIDC protocol development only; keep empty until configured.
FAN_SUPPORT_ADMIN_ACCESS_KEY=
FAN_SUPPORT_ADMIN_OIDC_ISSUER=

# API administration surface. All or nothing: the origin, OIDC settings JSON,
# peppers or client secret switch it on, and the access key and issuer above
# are then required too. Peppers, the access key and a confidential client
# secret come from the secret manager only. See
# docs/runbooks/production-configuration.md.
# FAN_SUPPORT_ADMIN_ORIGIN=
# FAN_SUPPORT_ADMIN_OIDC_CONFIG_JSON=
# FAN_SUPPORT_ADMIN_TOKEN_PEPPER=
# FAN_SUPPORT_ADMIN_SUBJECT_PEPPER=
# FAN_SUPPORT_ADMIN_OIDC_CLIENT_SECRET=
# Built-in admin accounts (ADR-021). ENABLED adds sign-in with a login name
# and password; OIDC settings then become optional. The label is what
# authenticator apps show (letters, digits, space, dot, dash; default
# "Studio Admin").
# FAN_SUPPORT_ADMIN_LOCAL_ACCOUNTS=
# FAN_SUPPORT_ADMIN_TOTP_ISSUER=

# Explicit public brand label; replace the local TEST value before release.
FAN_SUPPORT_STOREFRONT_NAME=TEST Studio
# Optional public storefront link shown in the management center.
FAN_SUPPORT_STOREFRONT_ORIGIN=

# Local PSP sandbox scripts only (never deployed; test-mode credentials only):
#   pnpm --filter @fan-support/payment-stripe sandbox
#   pnpm --filter @fan-support/payment-airwallex sandbox
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# AIRWALLEX_TEST_CLIENT_ID=
# AIRWALLEX_TEST_API_KEY=
# AIRWALLEX_TEST_WEBHOOK_SECRET=
