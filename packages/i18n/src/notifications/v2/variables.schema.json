{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "siteName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "publicOrderId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "orderedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "totalMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "items": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "idolName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "idolLocale": {
            "type": "string",
            "enum": ["en", "zh-CN", "th", "vi", "ja", "es", "pt"]
          },
          "giftName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "giftLocale": {
            "type": "string",
            "enum": ["en", "zh-CN", "th", "vi", "ja", "es", "pt"]
          },
          "variantName": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "variantLocale": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["en", "zh-CN", "th", "vi", "ja", "es", "pt"]
              },
              {
                "type": "null"
              }
            ]
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "lineTotalMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "giftKind": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": ["VIRTUAL", "PHYSICAL", "WISH", "MERCHANDISE", "OTHER"]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "idolName",
          "idolLocale",
          "giftName",
          "giftLocale",
          "variantName",
          "variantLocale",
          "quantity",
          "lineTotalMinor",
          "giftKind"
        ],
        "additionalProperties": false
      }
    },
    "orderUrl": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "required": [
    "schemaVersion",
    "siteName",
    "publicOrderId",
    "orderedAt",
    "currency",
    "totalMinor",
    "items",
    "orderUrl"
  ],
  "additionalProperties": false
}
