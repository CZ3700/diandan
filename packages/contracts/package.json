{
  "name": "@fan-support/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rum": {
      "types": "./dist/rum.d.ts",
      "import": "./dist/rum.js"
    },
    "./rum-browser": {
      "types": "./dist/rum-browser.d.ts",
      "import": "./dist/rum-browser.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
