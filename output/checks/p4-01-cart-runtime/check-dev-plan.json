{
  "schemaVersion": 1,
  "mode": "plan",
  "notice": "Development checks only; success is not formal acceptance. Use pnpm check and task-specific acceptance separately.",
  "scope": {
    "filter": null,
    "consumers": "all-workspaces",
    "packageDependencies": "transitive",
    "global": [
      "workspace",
      "domain-boundaries",
      "format",
      "lint"
    ]
  },
  "excludes": [
    "PostgreSQL",
    "S3",
    "browser",
    "formal acceptance"
  ],
  "commands": [
    {
      "label": "workspace",
      "command": "/Users/mario/.local/share/mise/installs/node/24.20.0/bin/node",
      "args": [
        "./scripts/check-workspace.mjs"
      ]
    },
    {
      "label": "domain-boundaries",
      "command": "/Users/mario/.local/share/mise/installs/node/24.20.0/bin/node",
      "args": [
        "./scripts/check-domain-boundaries.mjs"
      ]
    },
    {
      "label": "format",
      "command": "corepack",
      "args": [
        "pnpm",
        "run",
        "format:check"
      ]
    },
    {
      "label": "lint",
      "command": "corepack",
      "args": [
        "pnpm",
        "run",
        "lint"
      ]
    },
    {
      "label": "typecheck",
      "command": "corepack",
      "args": [
        "pnpm",
        "exec",
        "turbo",
        "run",
        "typecheck",
        "--output-logs=errors-only",
        "--concurrency=2"
      ]
    },
    {
      "label": "test",
      "command": "corepack",
      "args": [
        "pnpm",
        "exec",
        "turbo",
        "run",
        "test",
        "--output-logs=errors-only",
        "--concurrency=2"
      ]
    },
    {
      "label": "build",
      "command": "corepack",
      "args": [
        "pnpm",
        "exec",
        "turbo",
        "run",
        "build",
        "--output-logs=errors-only",
        "--concurrency=2"
      ]
    }
  ]
}
