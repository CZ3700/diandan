{
  "name": "@fan-support/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc -p tsconfig.json",
    "test:media-processing": "pnpm turbo run build --filter @fan-support/worker --output-logs=errors-only && node ./scripts/media-processing-integration.mjs"
  },
  "dependencies": {
    "@fan-support/application": "workspace:*",
    "@fan-support/config": "workspace:*",
    "@fan-support/contracts": "workspace:*",
    "@fan-support/observability": "workspace:*",
    "@fan-support/persistence-postgres": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "12.0.1",
    "fastify": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@fan-support/media-image": "workspace:*",
    "@fan-support/media-port": "workspace:*",
    "@fan-support/media-s3": "workspace:*",
    "@fan-support/persistence-port": "workspace:*",
    "@fan-support/cache-purge-port": "workspace:*",
    "@fan-support/cache-purge-cdn": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.13",
    "pg": "8.23.0",
    "sharp": "0.35.4"
  }
}
